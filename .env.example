DATABASE_URL=postgres://agent:agent@localhost:5432/agent_platform
PORT=3000
WORKER_ID=worker-local-1
LEASE_SECONDS=30
WORKER_POLL_MS=1000
WORKER_ROLES=
# Optional ML. The scikit-learn backend needs ml/requirements.txt in an isolated Python environment.
ML_ENABLED=false
ML_PYTHON=python
ML_TIMEOUT_MS=120000
# Optional neural backends (require ML_ENABLED=true). Each needs its own interpreter with its own pinned requirements:
# ml/requirements-pytorch.txt (CPU, or a CUDA build for explicit device "cuda") and ml/requirements-tensorflow.txt (CPU only).
ML_PYTORCH_ENABLED=false
ML_PYTORCH_PYTHON=python
ML_TENSORFLOW_ENABLED=false
ML_TENSORFLOW_PYTHON=python
# Optional native JAX backend, CPU only (requires ML_ENABLED=true and ml/requirements-jax.txt in ML_JAX_PYTHON).
ML_JAX_ENABLED=false
ML_JAX_PYTHON=python
# Optional XGBoost and LightGBM backends, CPU only (requires ML_ENABLED=true and ml/requirements-gbdt.txt; one
# interpreter can host both).
ML_XGBOOST_ENABLED=false
ML_XGBOOST_PYTHON=python
ML_LIGHTGBM_ENABLED=false
ML_LIGHTGBM_PYTHON=python
# Optional Hugging Face Transformers backend, CPU only (ml/requirements-transformers.txt in ML_TRANSFORMERS_PYTHON).
# ML_TRANSFORMERS_MODEL_ROOT must be an absolute path to an existing directory of operator-provisioned models, one directory
# per model with a meticule-model.json manifest (ml/transformers_manifest.py writes it). The root is platform-wide:
# every tenant may use every provisioned model. Nothing is downloaded and remote model code never runs.
ML_TRANSFORMERS_ENABLED=false
ML_TRANSFORMERS_PYTHON=python
ML_TRANSFORMERS_MODEL_ROOT=
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
SHUTDOWN_GRACE_MS=30000

# API authentication. Leave this empty until you generate local secret material outside source control.
AUTH_MODE=jwt
JWT_SECRET=
JWT_ISSUER=durable-agent-platform
JWT_AUDIENCE=durable-agent-api

# Local provider: models and capabilities must be explicit.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=llama3.1:8b
OLLAMA_MODEL_CAPABILITIES_JSON={"llama3.1:8b":{"toolCalling":true,"structuredOutput":true,"contextWindow":131072}}

# Retrieval remains disabled unless a real embedding model and its exact dimension are configured.
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=
OLLAMA_EMBEDDING_DIMENSIONS=
OLLAMA_EMBEDDING_TIMEOUT_MS=60000

# Exact connector origins only; empty disables MCP connectors.
CONNECTOR_EGRESS_ALLOWLIST=
CONNECTOR_ALLOW_PRIVATE_NETWORK=false
CONNECTOR_TIMEOUT_MS=60000
CONNECTOR_MAX_RESPONSE_BYTES=1000000
# Connector registrations reference environment variable names such as this one.
CONNECTOR_SECRET_EXAMPLE=

# Cloud providers are disabled unless explicitly enabled and credentialed.
ANTHROPIC_ENABLED=false
ANTHROPIC_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CAPABILITIES_JSON={}
GEMINI_ENABLED=false
GEMINI_MODELS=
GEMINI_API_KEY=
GEMINI_MODEL_CAPABILITIES_JSON={}
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODELS=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_CAPABILITIES_JSON={}
